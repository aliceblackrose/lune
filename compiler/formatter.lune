is_digit := fn(c) =>
    c >= 48 and c <= 57

is_alpha := fn(c) =>
    (c >= 97 and c <= 122) or
    (c >= 65 and c <= 90) or
    c == 95

is_space := fn(c) =>
    c == 32 or c == 9 or
    c == 11 or c == 12 or
    c == 13

operator_text := fn(text) =>
    text == ":=" or
    text == "=" or
    text == "=>" or
    text == "==" or
    text == "!=" or
    text == "<" or
    text == "<=" or
    text == ">" or
    text == ">=" or
    text == "+" or
    text == "-" or
    text == "*" or
    text == "/" or
    text == "%" or
    text == "and" or
    text == "or"

unary_context := fn(previous) =>
    previous == null or
    operator_text(previous) or
    previous == "(" or
    previous == "[" or
    previous == "{" or
    previous == "," or
    previous == ":"

scan_line := fn(line) => {
    tokens := []
    comment := null
    size := len(line)
    offset := 0

    while offset < size and comment == null {
        c := byte_at(line, offset)

        if is_space(c) {
            offset = offset + 1
        } else if (
            c == 47 and
            offset + 1 < size and
            byte_at(line, offset + 1) == 47
        ) {
            comment = slice(
                line,
                offset,
                size
            )
            offset = size
        } else if c == 34 {
            start := offset
            offset = offset + 1
            escaped := false
            done := false

            while offset < size and not done {
                current := byte_at(
                    line, offset
                )
                offset = offset + 1

                if escaped {
                    escaped = false
                } else if current == 92 {
                    escaped = true
                } else if current == 34 {
                    done = true
                }
            }

            push(tokens, slice(
                line, start, offset
            ))
        } else if is_alpha(c) {
            start := offset
            offset = offset + 1

            while (
                offset < size and
                (
                    is_alpha(
                        byte_at(line, offset)
                    ) or
                    is_digit(
                        byte_at(line, offset)
                    )
                )
            ) {
                offset = offset + 1
            }

            push(tokens, slice(
                line, start, offset
            ))
        } else if is_digit(c) {
            start := offset
            offset = offset + 1

            while (
                offset < size and
                is_digit(
                    byte_at(line, offset)
                )
            ) {
                offset = offset + 1
            }

            if (
                offset + 1 < size and
                byte_at(line, offset) == 46 and
                is_digit(
                    byte_at(line, offset + 1)
                )
            ) {
                offset = offset + 1

                while (
                    offset < size and
                    is_digit(
                        byte_at(line, offset)
                    )
                ) {
                    offset = offset + 1
                }
            }

            push(tokens, slice(
                line, start, offset
            ))
        } else {
            start := offset
            offset = offset + 1

            if offset < size {
                pair := slice(
                    line,
                    start,
                    offset + 1
                )

                if (
                    pair == ":=" or
                    pair == "=>" or
                    pair == "==" or
                    pair == "!=" or
                    pair == "<=" or
                    pair == ">="
                ) {
                    offset = offset + 1
                }
            }

            push(tokens, slice(
                line, start, offset
            ))
        }
    }

    {
        tokens: tokens,
        comment: comment,
    }
}

needs_space := fn(
    previous,
    current,
    previous_unary
) =>
    if previous == null {
        false
    } else if previous_unary {
        false
    } else if (
        current == ")" or
        current == "]" or
        current == "}" or
        current == "," or
        current == "." or
        current == ":"
    ) {
        false
    } else if (
        previous == "(" or
        previous == "[" or
        previous == "{" or
        previous == "."
    ) {
        false
    } else if current == "(" {
        false
    } else if (
        current == "[" and
        not operator_text(previous) and
        previous != "if" and
        previous != "while" and
        previous != "fn" and
        previous != "else" and
        previous != "not" and
        previous != "," and
        previous != ":"
    ) {
        false
    } else {
        true
    }

format_tokens := fn(tokens) => {
    output := ""
    previous := null
    previous_unary := false
    i := 0

    while i < len(tokens) {
        current := tokens[i]

        if needs_space(
            previous,
            current,
            previous_unary
        ) {
            output = output + " "
        }

        output = output + current

        current_unary := current == "-" and
            unary_context(previous)

        previous = current
        previous_unary = current_unary
        i = i + 1
    }

    output
}

leading_closures := fn(tokens) => {
    count := 0
    i := 0
    scanning := true

    while i < len(tokens) and scanning {
        if tokens[i] == "}" {
            count = count + 1
            i = i + 1
        } else {
            scanning = false
        }
    }

    count
}

brace_delta := fn(tokens) => {
    delta := 0
    i := 0

    while i < len(tokens) {
        if tokens[i] == "{" {
            delta = delta + 1
        } else if tokens[i] == "}" {
            delta = delta - 1
        }

        i = i + 1
    }

    delta
}

indent_text := fn(depth) => {
    output := ""
    i := 0

    while i < depth {
        output = output + "    "
        i = i + 1
    }

    output
}

format := fn(source) => {
    lines := split(source, "\n")
    limit := len(lines)

    if (
        limit > 0 and
        lines[limit - 1] == ""
    ) {
        limit = limit - 1
    }

    output := ""
    depth := 0
    line_index := 0

    while line_index < limit {
        line := lines[line_index]

        if (
            len(line) > 0 and
            byte_at(
                line,
                len(line) - 1
            ) == 13
        ) {
            line = slice(
                line,
                0,
                len(line) - 1
            )
        }

        scanned := scan_line(line)
        tokens := scanned.tokens
        comment := scanned.comment

        closes := leading_closures(tokens)
        line_depth := depth - closes

        if line_depth < 0 {
            line_depth = 0
        }

        code := format_tokens(tokens)

        if code != "" or comment != null {
            output = output +
                indent_text(line_depth)

            if code != "" {
                output = output + code
            }

            if comment != null {
                if code != "" {
                    output = output + "  "
                }

                output = output + comment
            }
        }

        output = output + "\n"

        depth = depth +
            brace_delta(tokens)

        if depth < 0 {
            depth = 0
        }

        line_index = line_index + 1
    }

    if limit == 0 {
        ""
    } else {
        output
    }
}

{
    format: format,
}
