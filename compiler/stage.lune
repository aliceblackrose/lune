compiler := import("./compiler")
bytecode := import("./bytecode")

if len(args) < 2 {
    print(
        "usage: stage.lune SOURCE OUTPUT [module]"
    )
    exit(2)
}

source_path := args[0]
output_path := args[1]
module_mode := len(args) >= 3 and
    args[2] == "module"

source := read_file(source_path)

module_prefix := "fn() => {\n"

input := if module_mode {
    module_prefix +
    source +
    "\n}\n"
} else {
    source
}

repeat_text := fn(text, count) => {
    output := ""
    i := 0

    while i < count {
        output = output + text
        i = i + 1
    }

    output
}

display_error := fn(error) => {
    start := error.start
    line := error.line
    column := error.column

    if module_mode {
        prefix_length := len(module_prefix)

        start = if start >= prefix_length {
            start - prefix_length
        } else {
            0
        }

        line = if line > 1 {
            line - 1
        } else {
            1
        }
    }

    if start > len(source) {
        start = len(source)
    }

    line_start := start

    while (
        line_start > 0 and
        byte_at(source, line_start - 1) != 10
    ) {
        line_start = line_start - 1
    }

    line_end := start

    while (
        line_end < len(source) and
        byte_at(source, line_end) != 10
    ) {
        line_end = line_end + 1
    }

    if (
        line_end > line_start and
        byte_at(source, line_end - 1) == 13
    ) {
        line_end = line_end - 1
    }

    excerpt := slice(
        source,
        line_start,
        line_end
    )

    marker_prefix := ""
    marker_index := line_start

    while marker_index < start {
        marker_prefix = marker_prefix +
            if byte_at(source, marker_index) == 9 {
                "\t"
            } else {
                " "
            }

        marker_index = marker_index + 1
    }

    available := line_end - start

    marker_length := if error.length > 0 {
        error.length
    } else {
        1
    }

    if (
        available > 0 and
        marker_length > available
    ) {
        marker_length = available
    }

    if marker_length < 1 {
        marker_length = 1
    }

    print(
        source_path +
        ":" +
        str(line) +
        ":" +
        str(column) +
        ": error: " +
        error.message
    )

    print("  " + excerpt)

    print(
        "  " +
        marker_prefix +
        repeat_text("^", marker_length)
    )

    null
}

compiled := compiler.compile(input)

if len(compiled.errors) > 0 {
    i := 0

    while i < len(compiled.errors) {
        display_error(
            compiled.errors[i]
        )

        i = i + 1
    }

    exit(1)
}

image := bytecode.encode(
    compiled.chunk
)

write_file(
    output_path,
    image
)

null
