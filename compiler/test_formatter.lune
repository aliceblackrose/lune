formatter := import("./formatter")

assert := fn(condition, message) =>
    if condition {
        null
    } else {
        eprint(
            "formatter test failed:",
            message
        )
        exit(1)
    }

input := ""
input = input + "x:= [1,2] // keep me\n"
input = input + "if x[0]<2 {\n"
input = input + " y:={a:1,b:-2}\n"
input = input + "   // nested comment\n"
input = input + " print(y.a)\n"
input = input + "}\n"

expected := ""
expected = expected + "x := [1, 2]  // keep me\n"
expected = expected + "if x[0] < 2 {\n"
expected = expected + "    y := {a: 1, b: -2}\n"
expected = expected + "    // nested comment\n"
expected = expected + "    print(y.a)\n"
expected = expected + "}\n"

formatted := formatter.format(input)

assert(
    formatted == expected,
    "canonical output"
)

assert(
    formatter.format(formatted) ==
        formatted,
    "idempotence"
)

multiline := ""
multiline = multiline + "values := [\n"
multiline = multiline + "1,2,\n"
multiline = multiline + "3,\n"
multiline = multiline + "]\n"

expected_multiline := ""
expected_multiline =
    expected_multiline + "values := [\n"
expected_multiline =
    expected_multiline + "1, 2,\n"
expected_multiline =
    expected_multiline + "3,\n"
expected_multiline =
    expected_multiline + "]\n"

assert(
    formatter.format(multiline) ==
        expected_multiline,
    "multiline collection"
)

string_comment := "x:=\"// not a comment\"// real\n"

assert(
    formatter.format(string_comment) ==
        "x := \"// not a comment\"  // real\n",
    "string and comment"
)

print("self-hosted formatter tests passed")
