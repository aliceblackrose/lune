web := import("../../lib/web")
request := web.request()

home := fn(req) => {
    name := req.query_params.name or "world"
    body := ("<main style=\"font-family:system-ui;max-width:48rem;margin:4rem auto\">" +
        "<h1>Hello, " + web.escape_html(name) + "</h1>" +
        "<p>This page is rendered by Lune.</p>" +
        "<p>Try <a href=\"/api/hello?name=Alice%20Blackrose\">the JSON endpoint</a>.</p>" +
        "</main>")
    web.html(web.html_document("Lune web demo", body))
}

hello := fn(req) => web.json({
    message: "hello, " + (req.query_params.name or "world"),
    method: req.method,
    path: req.path,
})

echo := fn(req) => web.json({
    method: req.method,
    body: req.body,
    content_type: req.headers["content-type"],
})

routes := {
    "GET /": home,
    "GET /api/hello": hello,
    "POST /api/echo": echo,
}

print(json_stringify(web.dispatch(routes, request)))
